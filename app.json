{
  "expo": {
    "name": "Tijarah AI",
    "slug": "expo-template-default",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tijarah_logo_light.png",
    "scheme": "helloworld",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tijarah_logo_light.png"
    },
    "android": {
      "backgroundColor": "#f6f7f8",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#e1f2ee",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.masood0901.expotemplatedefault"
    },
    "backgroundColor": "#f6f7f8",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f7f8",
          "image": "./assets/images/tijarah_logo_light.png",
          "dark": {
            "backgroundColor": "#1a1f23",
            "image": "./assets/images/tijarah_logo_dark.png"
          },
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b07e45e-606d-495f-b731-7f97e1d9a152"
      }
    }
  }
}
